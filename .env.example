# Paikallisen SQLite-tietokannan oletuspolku on data/hankevahti.db.
# Voit tarvittaessa ylikirjoittaa yhteyden SQLAlchemy-URL:lla.
# DATABASE_URL=sqlite:///data/hankevahti.db
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# AI-soveltuvuusarvio ja hakemustekstin muotoilu: gemini (oletus) tai openai.
AI_PROVIDER=gemini

# Gemini: AI-soveltuvuusarvio ja hakemustekstin muotoilu.
# Lisää oma avain ja käytettävissäsi olevan mallin nimi.
GEMINI_API_KEY=
GEMINI_MODEL=

# Vaihtoehtoinen OpenAI-yhteys: käytetään vain kun AI_PROVIDER=openai.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Ilmoitusajo: jätä relevanssiraja tyhjäksi, kunnes se on päätetty.
NOTIFICATION_EMAIL_TO=
NOTIFICATION_MIN_RELEVANCE_SCORE=
NOTIFICATION_RUN_TIME=09:00

# SMTP: choose values from your mail provider. Keep real credentials in local .env only.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
